# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG BASE_IMAGE=litellm-pool-base:ea57c0345c
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

ARG LITELLM_RELEASE_TAG=exclusive-pool-key-policies-20261105
ARG SOURCE_REVISION=development
ENV LITELLM_RELEASE_TAG=${LITELLM_RELEASE_TAG}
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
LABEL org.opencontainers.image.base.name=${BASE_IMAGE}

COPY litellm/litellm_core_utils/device_identity.py /app/.venv/lib/python3.13/site-packages/litellm/litellm_core_utils/
COPY litellm/router_utils/exclusive_pool/ /app/.venv/lib/python3.13/site-packages/litellm/router_utils/exclusive_pool/
COPY litellm/proxy/common_request_processing.py litellm/proxy/proxy_server.py litellm/proxy/utils.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/
COPY litellm/proxy/auth/user_api_key_auth.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/auth/
COPY litellm/proxy/management_endpoints/key_management_endpoints.py litellm/proxy/management_endpoints/organization_endpoints.py litellm/proxy/management_endpoints/team_endpoints.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/management_endpoints/
COPY litellm/proxy/management_helpers/key_budget_policy.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/management_helpers/
