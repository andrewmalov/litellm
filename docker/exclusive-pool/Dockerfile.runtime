# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG BASE_IMAGE=cr.selcloud.ru/ttkdc/litellm@sha256:3c69d855a2708655390add8f8392341a43dc4228a1c9e7ca10723dff43c8cf56
FROM ${BASE_IMAGE}
ARG BASE_IMAGE

ARG LITELLM_RELEASE_TAG=exclusive-pool-monthly-budget
ARG SOURCE_REVISION=development
ENV LITELLM_RELEASE_TAG=${LITELLM_RELEASE_TAG}
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
LABEL org.opencontainers.image.base.name=${BASE_IMAGE}

COPY litellm/litellm_core_utils/device_identity.py litellm/litellm_core_utils/token_counter.py /app/.venv/lib/python3.13/site-packages/litellm/litellm_core_utils/
COPY litellm/router_utils/exclusive_pool/ /app/.venv/lib/python3.13/site-packages/litellm/router_utils/exclusive_pool/
COPY litellm/proxy/common_request_processing.py litellm/proxy/proxy_server.py litellm/proxy/utils.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/
COPY litellm/proxy/auth/user_api_key_auth.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/auth/
COPY litellm/proxy/management_endpoints/key_management_endpoints.py litellm/proxy/management_endpoints/organization_endpoints.py litellm/proxy/management_endpoints/team_endpoints.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/management_endpoints/
COPY litellm/proxy/management_helpers/key_budget_policy.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/management_helpers/
COPY litellm/proxy/management_helpers/utils.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/management_helpers/
COPY litellm/proxy/anthropic_endpoints/endpoints.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/anthropic_endpoints/

COPY litellm/llms/anthropic/count_tokens/transformation.py /app/.venv/lib/python3.13/site-packages/litellm/llms/anthropic/count_tokens/

COPY litellm/models/budget.py /app/.venv/lib/python3.13/site-packages/litellm/models/
COPY litellm/proxy/_types.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/
COPY litellm/proxy/common_utils/timezone_utils.py litellm/proxy/common_utils/reset_budget_job.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/common_utils/
COPY litellm/proxy/management_endpoints/budget_management_endpoints.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/management_endpoints/
COPY schema.prisma /app/schema.prisma
COPY litellm/proxy/schema.prisma /app/.venv/lib/python3.13/site-packages/litellm/proxy/schema.prisma
COPY litellm-proxy-extras/litellm_proxy_extras/schema.prisma /app/litellm-proxy-extras/litellm_proxy_extras/schema.prisma
COPY litellm-proxy-extras/litellm_proxy_extras/schema.prisma /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/schema.prisma
COPY litellm-proxy-extras/litellm_proxy_extras/migrations/20261111150000_add_budget_reset_day/ /app/litellm-proxy-extras/litellm_proxy_extras/migrations/20261111150000_add_budget_reset_day/
COPY litellm-proxy-extras/litellm_proxy_extras/migrations/20261111150000_add_budget_reset_day/ /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras/migrations/20261111150000_add_budget_reset_day/
RUN prisma generate --schema=/app/schema.prisma && \
    python -c "from litellm.router_utils.exclusive_pool.callback import ExclusiveEndpointPool; from prisma.models import LiteLLM_BudgetTable; assert 'budget_reset_day' in LiteLLM_BudgetTable.model_fields"
