# ============================================
# LiteLLM TTK Deployment - Environment Template
# ============================================
# Copy this file to .env.ttk.local and fill in values
# NEVER commit .env.ttk.local to version control!

# --- Domain Configuration ---
DOMAIN=llmfw.cloudttk.ru
CADDY_EMAIL=admin@cloudttk.ru

# --- Database ---
# Use ONLY alphanumeric chars. Special chars (@, /, #, :, etc.) break DATABASE_URL parsing.
POSTGRES_PASSWORD=CHANGE_ME_secure_password_here

# --- LiteLLM Security ---
# Master key for admin API - REQUIRED, use strong random value
# Generate with: openssl rand -base64 32
LITELLM_MASTER_KEY=CHANGE_ME_generate_strong_master_key

# LiteLLM UI credentials
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=CHANGE_ME_secure_ui_password

# --- Enterprise License ---
# Get your license at https://license.litellm.ai
LITELLM_PREMIUM_USER=True
